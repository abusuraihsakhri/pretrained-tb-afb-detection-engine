*.py[cod]
*$py.class
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
*.pid
Tuberculosis-1/
scratch/

