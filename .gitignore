!03_MODELS/best.pt.sha256
!03_MODELS/.gitkeep
/best.pt

# Clinical Audit Logs (Prevent PHI leak in logs)
06_LOGS/*
*.log
!06_LOGS/.gitkeep

# Python Environment & Junk
